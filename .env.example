# ==============================================================================
# AI Voice Assistant - Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# Supabase Configuration (Client & Server)
# Obtain these from your Supabase Dashboard -> Project Settings -> API
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ------------------------------------------------------------------------------
# Supabase Server-Only Role Key (Optional / Administrative)
# NEVER prefix with NEXT_PUBLIC_ or expose to client-side code!
# ------------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ------------------------------------------------------------------------------
# AI LLM Provider Configuration (Server-Only)
# Works with OpenAI, Groq, OpenRouter, DeepSeek, or any OpenAI-compatible API.
# ------------------------------------------------------------------------------
AI_API_KEY=your-ai-api-key-here
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1

# Alternative specific provider keys (auto-detected if AI_API_KEY is omitted):
# OPENAI_API_KEY=sk-...
# GROQ_API_KEY=gsk-...

# ------------------------------------------------------------------------------
# Application URL Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
